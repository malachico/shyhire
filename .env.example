# Where people reach this app (no trailing slash), e.g. https://talent.parly.dev
APP_URL=http://localhost:3100
# Signs the session cookie: at least 32 random bytes.
SESSION_SECRET=
# GitHub OAuth (the "Parly Talent" GitHub App's client).
TALENT_GITHUB_CLIENT_ID=
TALENT_GITHUB_CLIENT_SECRET=
# Parly Apps API: a key from Parly workspace settings → Apps.
PARLY_API_URL=https://hub.parly.dev
PARLY_API_KEY=
# The app's webhook secret (whsec_...), shown once when the app was made.
PARLY_WEBHOOK_SECRET=
