# Where people reach this app (no trailing slash), e.g. https://talent.parly.dev
APP_URL=http://localhost:3100
# Signs the session cookie: at least 32 random bytes.
SESSION_SECRET=
# Bearer secret for /api/cron/roles (Vercel Cron sends it).
CRON_SECRET=
# Google OAuth 2.0 Web client for sign-in (callback: <APP_URL>/talent/auth/google/callback).
TALENT_GOOGLE_CLIENT_ID=
TALENT_GOOGLE_CLIENT_SECRET=
# GitHub OAuth (optional profile connection: the "Parly Talent" GitHub App's client).
TALENT_GITHUB_CLIENT_ID=
TALENT_GITHUB_CLIENT_SECRET=
# Firestore in Talent's own GCP project (Vercel OIDC + Workload Identity Federation in prod; FIRESTORE_EMULATOR_HOST locally).
GCP_PROJECT_ID=parly-talent-0a7c87
GCP_PROJECT_NUMBER=
GCP_SERVICE_ACCOUNT_EMAIL=
GCP_WORKLOAD_IDENTITY_POOL_ID=vercel
GCP_WORKLOAD_IDENTITY_POOL_PROVIDER_ID=vercel
FIRESTORE_EMULATOR_HOST=127.0.0.1:8085
# Optional: LinkedIn OpenID Connect profile connection (callback: <APP_URL>/talent/auth/linkedin/callback) & SMTP for work-email verification codes.
TALENT_LINKEDIN_CLIENT_ID=
TALENT_LINKEDIN_CLIENT_SECRET=
SMTP_USER=
SMTP_APP_PASSWORD=
# Optional: Vertex AI CV/PDF profile import & monthly per-user LLM budget.
VERTEX_PROJECT=parly-talent-0a7c87
VERTEX_LOCATION=global
VERTEX_MODEL=gemini-2.5-flash
LLM_MONTHLY_ALLOWANCE_USD=5
LLM_PRICE_INPUT_PER_MTOK=0.3
LLM_PRICE_OUTPUT_PER_MTOK=2.5
# Parly Apps API: a key from Parly workspace settings → Apps.
PARLY_API_URL=https://hub.parly.dev
PARLY_API_KEY=
# The app's webhook secret (whsec_...), shown once when the app was made.
PARLY_WEBHOOK_SECRET=

